{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "benchmark_id": "folklore-public-variant-interpretation-v1",
  "title": "Public germline variant interpretation contract benchmark",
  "publisher": "Helena Bioinformatics",
  "server": "Folklore Clinical Variant Interpretation MCP",
  "registry_identity": "io.github.helena-bioinformatics/folklore",
  "adapter_release": "1.7.0",
  "endpoint": "https://api.helena.bio/folklore/v1/mcp",
  "case_set": "cases.csv",
  "capture_harness": "capture_folklore.py",
  "method": "COMPARISON_METHOD.md",
  "input_scope": {
    "assembly": "GRCh38",
    "data": "public variant expressions only",
    "supported_focus": "germline nuclear SNVs and simple indels smaller than 50 bp"
  },
  "measured_fields": [
    "input identity",
    "normalized allele",
    "typed outcome",
    "automated classification",
    "applied criteria",
    "evidence availability",
    "source provenance",
    "contract version",
    "elapsed time",
    "input and output contract"
  ],
  "metrics": [
    "identity concordance",
    "five-class concordance",
    "criterion concordance",
    "provenance completeness",
    "typed-outcome handling",
    "reproducibility",
    "latency"
  ]
}
