{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/helena-bioinformatics/folklore-mcp/blob/main/registry/agent-selection.schema.json",
  "title": "Agent selection contract for Folklore Clinical Variant Interpretation MCP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "selection",
    "inputScope",
    "routing",
    "outcomes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "2"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "registryName",
        "endpoint",
        "task"
      ],
      "properties": {
        "title": {
          "const": "Folklore Clinical Variant Interpretation MCP"
        },
        "publisher": {
          "const": "Helena Bioinformatics"
        },
        "registryName": {
          "const": "io.github.helena-bioinformatics/folklore"
        },
        "endpoint": {
          "format": "uri",
          "type": "string"
        },
        "task": {
          "minLength": 40,
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implicit",
        "positiveIntents",
        "exampleRequests"
      ],
      "properties": {
        "implicit": {
          "const": true
        },
        "positiveIntents": {
          "items": {
            "type": "string"
          },
          "minItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "exampleRequests": {
          "items": {
            "type": "string"
          },
          "minItems": 8,
          "type": "array",
          "uniqueItems": true
        }
      }
    },
    "inputScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantAssembly",
        "accepted",
        "variantExcluded"
      ],
      "properties": {
        "accepted": {
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        },
        "variantAssembly": {
          "const": "GRCh38"
        },
        "variantExcluded": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job",
          "tool"
        ],
        "properties": {
          "job": {
            "type": "string"
          },
          "tool": {
            "enum": [
              "classify_germline_variant",
              "search_variant_literature",
              "get_publication_details",
              "search_literature_corpus",
              "get_gene_disease_associations",
              "search_disease_genes",
              "resolve_gene",
              "get_gene_profile",
              "get_gene_section",
              "search_gene_literature"
            ]
          }
        }
      },
      "minItems": 4
    },
    "outcomes": {
      "items": {
        "enum": [
          "resolved",
          "ambiguous",
          "not_found",
          "invalid_request",
          "unsupported",
          "resolution_unavailable"
        ]
      },
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "uniqueItems": true
    }
  }
}
