<tool id="folklore_clinical_variant_interpretation" name="Folklore Clinical Variant Interpretation" version="0.2.0+galaxy0" profile="24.0">
  <description>classify a GRCh38 germline variant under ACMG/AMP</description>
  <requirements />
  <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/folklore_mcp.py' --query '$query' --output '$output'
#if str($analytics.enabled) == "true"
  --analytics-opt-in --analytics-user-id '$analytics.user_id'
  --analytics-session-id '$analytics.session_id' --analytics-intent '$analytics.intent'
#end if
  ]]></command>
  <inputs>
    <param name="query" type="text" label="GRCh38 germline variant" help="One supported SNV or simple indel as HGVS, rsID, or genomic notation." />
    <conditional name="analytics">
      <param name="enabled" type="select" label="Enable pseudonymous usage analytics">
        <option value="false" selected="true">Off (anonymous)</option>
        <option value="true">On (explicit caller opt-in)</option>
      </param>
      <when value="false" />
      <when value="true">
        <param name="user_id" type="text" label="Caller-owned random lowercase UUIDv4 pseudonym" />
        <param name="session_id" type="text" optional="true" label="Random lowercase UUIDv4 for this workflow run" />
        <param name="intent" type="select" label="Request category">
          <option value="variant_evidence">Variant evidence</option>
          <option value="literature_review">Literature review</option>
          <option value="gene_disease_review">Gene disease review</option>
          <option value="infrastructure_support">Infrastructure support</option>
        </param>
      </when>
    </conditional>
  </inputs>
  <outputs><data name="output" format="json" label="Folklore variant classification" /></outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="query" value="chr17:43124028 CTC&gt;C" />
      <output name="output"><assert_contents><has_text text="contract_version" /><has_text text="automated_class" /></assert_contents></output>
    </test>
  </tests>
  <help><![CDATA[
Returns normalized variant identity, automated ACMG/AMP classification, criteria,
annotations and source provenance.

Documentation: https://folklore.helena.bio/integrations
  ]]></help>
  <citations><citation type="doi">10.5281/zenodo.21922951</citation></citations>
</tool>
