  "encoding": {
    "input_safe_integer_cap": 9007199254740991,
    "input_cap_scope": [
      "demographics.age_years",
      "reproductive.gestational_age_weeks"
    ],
    "input_cap_reason": "MCP encoding restriction; API clinical StrictInt has no source upper bound.",
    "input_integer_rules": "Reject booleans, strings and fractional representations for integer fields. Validate source strictness after JSON Schema; format validation is enabled.",
    "output_source_schemas": "Structural contracts describe source numeric types before MCP output encoding, not final MCP result schemas.",
    "output_numeric_values": "Encode every numeric source value recursively as a canonical decimal string before result serialization; retain only adapter pagination/count/budget metadata as bounded JSON integers. Never round through binary64. Use decimal-aware parsing of source JSON. Preserve source integer versus decimal semantics in schema metadata.",
    "maximum_cost": "Use exact decimal comparison, never a binary64 schema maximum for signed64 cost values."
  },
  "semantic_validators": [
    "Apply source defaults before normalized-command hashing. Default modules={}, phenotype={}, legacy clinical={}, outputs=[json], optional profile fields=null where permitted. Do not insert forbidden unused root fields.",
    "VCF profiles forbid explicitly supplied sequencing even null. V1 forbids explicitly supplied clinical_profile even null and requires json in outputs. V2 and singleton sequencing forbid explicitly supplied legacy clinical even empty. Trio is not accepted in Phase 1.",
    "Key and version_id reject code points below 32. Version_id case-insensitive null/latest is invalid. VCF key must end case-insensitively .vcf or .vcf.gz.",
    "The API independently enforces admitted source connection, bucket, relative root containment and immutable object version. No absolute keys, backslash or dot/dotdot segments are introduced by MCP.",
    "Normalize HPO lists to sorted unique exact IDs; normalize outputs sorted unique; normalize panel UUID strings to sorted unique canonical UUIDs; check original source array-length bounds before deduplication.",
    "Demographic age_years and age_days may not both be nonnull. Clinical screening true requires nonnull explicit secondary_findings and carrier_results consent choices. Nonempty panel_ids/custom_genes requires screening true.",
    "Panel IDs parse as UUIDs. No whitespace trimming or gene uppercasing is invented. Preserve nullable fields versus omitted/defaulted command semantics.",
    "FASTQ object roles must be exactly R1,R2 and suffix .fastq.gz/.fq.gz; BAM/CRAM exactly ALIGNMENT with matching extension. Object bucket/key pairs must be distinct even at different versions. Normalize objects sorted by role.",
    "Sequencing prices contain exactly one inclusive tariff line; key sequencing.{assay lower}.{input_type lower}.{analysis_unit}; line cost equals total. Status pricing is an immutable allowlisted snapshot, not a new spending permission.",
    "Machine input never contains an API key, fake user_id, caller payer, internal path or service secret. Credential is secure transport/configuration only.",
    "Status source has conditional singleton sequencing fields and links. Preserve null secondary IDs before job creation. Review warning keys are optional and values are source-owned; no stronger source types are claimed.",
    "Review body must match current job_id, attempt_id, manifest_sha256 and acknowledged=true. Exact stored review replay is valid; stale/different review conflicts. VCF review/cancel returns unsupported-profile conflict.",
    "Cancellation of terminal/already-requested sequencing command returns current row; requested cancellation is not proof of stopped writers or settled billing.",
    "Manifest identity must match requested analysis; artifact UUID/kind/type/size/digest and relative path must match exact constructed route. Digest is canonical sorted compact ensure_ascii JSON without manifest_sha256.",
    "Retention expires_at is offset-aware and current. Do not hardcode configured default 30 days. Download same opened no-follow file verified for exact size/hash; no Range,304 or presigned download contract.",
    "Source result statuses/stages and bounded schemas are closed for Phase 1; unknown source contract values yield typed source-contract mismatch rather than invented success."
  ],
  "replay": {
    "machine_namespace": [
      "installation_id",
      "organization_id",
      "machine_principal_id",
      "idempotency_key"
    ],
    "normalization": "Source Pydantic serializer removes unused clinical/sequencing fields, materializes allowed defaults, normalizes HPO/output/panel/role ordering, hashes sorted compact ASCII-escaped JSON.",
    "billing_match": [
      "billing_arrangement_id",
      "payer_organization_id"
    ],
    "credential_rotation": "Credential ID is not part of command idempotency namespace; current admission remains required.",
    "uncertain_submit": "Replay original key and exact normalized command. Replayed POST may omit joined billing state; GET status is authoritative for current accounting.",
    "review": "Exact same current receipt may replay; review_conflict covers stale identity, differing acknowledgement or no longer awaiting first review.",
    "cancel": "Repeat original analysis cancellation and inspect current status; do not synthesize a cancelled status."
  },
