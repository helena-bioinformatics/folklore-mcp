{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 1 Folklore MCP API schemas and source contracts",
  "version": "1",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid"
    },
    "Digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "SafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "CostDecimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "x-semantic-validator": "decimal value <= 9223372036854775807; convert exactly to API StrictInt"
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[\\x20-\\x7E]+$"
    },
    "HpoId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^HP:[0-9]{7}$"
    },
    "S3ObjectInput": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "s3_object"
        },
        "connection_id": {
          "$ref": "#/$defs/UUID"
        },
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "kind",
        "connection_id",
        "bucket",
        "key",
        "version_id"
      ],
      "additionalProperties": false
    },
    "ClinicalInputs": {
      "type": "object",
      "properties": {
        "hpo_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HpoId"
          },
          "maxItems": 200,
          "default": []
        },
        "filtering_preset": {
          "type": "string",
          "enum": [
            "strict",
            "balanced",
            "permissive"
          ],
          "default": "strict"
        },
        "language": {
          "const": "en",
          "default": "en"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Demographics": {
      "type": "object",
      "properties": {
        "sex": {
          "type": "string",
          "enum": [
            "male",
            "female",
            "unknown"
          ]
        },
        "age_years": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "age_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "age_group": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sex"
      ],
      "additionalProperties": false
    },
    "Modules": {
      "type": "object",
      "properties": {
        "enable_screening": {
          "type": "boolean",
          "default": false
        },
        "enable_literature": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Ethnicity": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "populations": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "primary"
      ],
      "additionalProperties": false
    },
    "FamilyHistory": {
      "type": "object",
      "properties": {
        "has_affected_relatives": {
          "type": "boolean",
          "default": false
        },
        "consanguinity": {
          "type": "boolean",
          "default": false
        },
        "details": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ClinicalContext": {
      "type": "object",
      "properties": {
        "indication": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "indication_details": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "family_history": {
          "anyOf": [
            {
              "$ref": "#/$defs/FamilyHistory"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Reproductive": {
      "type": "object",
      "properties": {
        "is_pregnant": {
          "type": "boolean",
          "default": false
        },
        "gestational_age_weeks": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "family_planning": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SampleInfo": {
      "type": "object",
      "properties": {
        "sample_type": {
          "anyOf": [
            {
              "const": "singleton"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_parental_samples": {
          "type": "boolean",
          "default": false
        },
        "has_affected_sibling": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Consent": {
      "type": "object",
      "properties": {
        "secondary_findings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "carrier_results": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pharmacogenomics": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Phenotype": {
      "type": "object",
      "properties": {
        "hpo_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HpoId"
          },
          "maxItems": 200,
          "default": []
        },
        "clinical_notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "CustomGene": {
      "type": "object",
      "properties": {
        "gene_symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "priority_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "age_group_relevance": {
          "type": "string",
          "enum": [
            "neonatal",
            "pediatric",
            "adult",
            "all"
          ],
          "default": "all"
        },
        "disease_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "gene_symbol"
      ],
      "additionalProperties": false
    },
    "ClinicalProfile": {
      "type": "object",
      "properties": {
        "demographics": {
          "$ref": "#/$defs/Demographics"
        },
        "modules": {
          "$ref": "#/$defs/Modules"
        },
        "ethnicity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ethnicity"
            },
            {
              "type": "null"
            }
          ]
        },
        "clinical_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClinicalContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "reproductive": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reproductive"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "consent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Consent"
            },
            {
              "type": "null"
            }
          ]
        },
        "phenotype": {
          "$ref": "#/$defs/Phenotype"
        },
        "panel_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "custom_genes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomGene"
              },
              "maxItems": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "const": "en",
          "default": "en"
        },
        "filtering_preset": {
          "type": "string",
          "enum": [
            "strict",
            "balanced",
            "permissive"
          ],
          "default": "strict"
        }
      },
      "required": [
        "demographics"
      ],
      "additionalProperties": false
    },
    "SequencingObject": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "R1",
            "R2",
            "ALIGNMENT"
          ]
        },
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "role",
        "bucket",
        "key",
        "version_id"
      ],
      "additionalProperties": false
    },
    "SequencingInput": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "s3_sequencing"
        },
        "input_type": {
          "type": "string",
          "enum": [
            "FASTQ",
            "BAM",
            "CRAM"
          ]
        },
        "connection_id": {
          "$ref": "#/$defs/UUID"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequencingObject"
          },
          "maxItems": 2,
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "input_type",
        "connection_id",
        "objects"
      ],
      "additionalProperties": false
    },
    "SequencingSample": {
      "type": "object",
      "properties": {
        "sample_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "platform": {
          "const": "ILLUMINA"
        },
        "assay_type": {
          "type": "string",
          "enum": [
            "WES",
            "WGS"
          ]
        },
        "read_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "library_protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequencer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_x_ploidy": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sample_id",
        "platform",
        "assay_type",
        "read_length",
        "library_protocol",
        "sequencer"
      ],
      "additionalProperties": false
    },
    "SequencingSettings": {
      "type": "object",
      "properties": {
        "sample": {
          "$ref": "#/$defs/SequencingSample"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "caller_selection": {
          "type": "string",
          "enum": [
            "default",
            "deepvariant",
            "gatk"
          ],
          "default": "default"
        }
      },
      "required": [
        "sample",
        "release_id",
        "reference_id"
      ],
      "additionalProperties": false
    },
    "SubmitV1": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/IdempotencyKey"
        },
        "context_binding_id": {
          "$ref": "#/$defs/UUID"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "json",
              "pdf"
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "json"
          ],
          "contains": {
            "const": "json"
          }
        },
        "max_cost_units": {
          "$ref": "#/$defs/CostDecimal"
        },
        "profile": {
          "const": "singleton-germline-v1"
        },
        "input": {
          "$ref": "#/$defs/S3ObjectInput"
        },
        "clinical": {
          "$ref": "#/$defs/ClinicalInputs"
        }
      },
      "required": [
        "idempotency_key",
        "context_binding_id",
        "profile",
        "input",
        "max_cost_units"
      ],
      "additionalProperties": false
    },
    "SubmitV2": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/IdempotencyKey"
        },
        "context_binding_id": {
          "$ref": "#/$defs/UUID"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "json",
              "pdf"
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "json"
          ]
        },
        "max_cost_units": {
          "$ref": "#/$defs/CostDecimal"
        },
        "profile": {
          "const": "singleton-germline-v2"
        },
        "input": {
          "$ref": "#/$defs/S3ObjectInput"
        },
        "clinical_profile": {
          "$ref": "#/$defs/ClinicalProfile"
        }
      },
      "required": [
        "idempotency_key",
        "context_binding_id",
        "profile",
        "input",
        "max_cost_units",
        "clinical_profile"
      ],
      "additionalProperties": false
    },
    "SubmitSequencing": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "$ref": "#/$defs/IdempotencyKey"
        },
        "context_binding_id": {
          "$ref": "#/$defs/UUID"
        },
        "external_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "json",
              "pdf"
            ]
          },
          "maxItems": 2,
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "json"
          ]
        },
        "max_cost_units": {
          "$ref": "#/$defs/CostDecimal"
        },
        "profile": {
          "const": "singleton-sequencing-v1"
        },
        "input": {
          "$ref": "#/$defs/SequencingInput"
        },
        "sequencing": {
          "$ref": "#/$defs/SequencingSettings"
        },
        "clinical_profile": {
          "$ref": "#/$defs/ClinicalProfile"
        }
      },
      "required": [
        "idempotency_key",
        "context_binding_id",
        "profile",
        "input",
        "max_cost_units",
        "sequencing",
        "clinical_profile"
      ],
      "additionalProperties": false
    },
    "ConnectionGrant": {
      "type": "object",
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/UUID"
        },
        "bucket": {
          "type": "string"
        },
        "key_prefix": {
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "bucket",
        "key_prefix"
      ],
      "additionalProperties": false
    },
    "PartnerPrice": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "singleton-germline-v1",
            "singleton-germline-v2"
          ]
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0,
          "x-source-maximum-decimal": "9223372036854775807"
        },
        "catalog_version": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "profile",
        "cost_units",
        "catalog_version",
        "effective_from"
      ],
      "additionalProperties": false
    },
    "SequencingPriceItem": {
      "type": "object",
      "properties": {
        "operation_key": {
          "type": "string"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "operation_key",
        "cost_units"
      ],
      "additionalProperties": false
    },
    "SequencingPrice": {
      "type": "object",
      "properties": {
        "assay_type": {
          "type": "string",
          "enum": [
            "WES",
            "WGS"
          ]
        },
        "input_type": {
          "type": "string",
          "enum": [
            "FASTQ",
            "BAM",
            "CRAM"
          ]
        },
        "analysis_unit": {
          "type": "string",
          "enum": [
            "singleton",
            "trio"
          ]
        },
        "operation_key": {
          "type": "string"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_version": {
          "type": "string"
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "line_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequencingPriceItem"
          },
          "maxItems": 1,
          "minItems": 1
        }
      },
      "required": [
        "assay_type",
        "input_type",
        "analysis_unit",
        "operation_key",
        "cost_units",
        "catalog_version",
        "effective_from",
        "line_items"
      ],
      "additionalProperties": false
    },
    "Billing": {
      "type": "object",
      "properties": {
        "unit": {
          "const": "credit_unit"
        },
        "units_per_credit": {
          "const": 1000
        },
        "payer_organization_id": {
          "$ref": "#/$defs/UUID"
        },
        "balance_status": {
          "type": "string"
        },
        "available_units": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_units": {
          "type": "integer",
          "minimum": 0
        },
        "price_status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartnerPrice"
          }
        },
        "sequencing_prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SequencingPrice"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "billing_url": {
          "const": "https://account.helena.bio/billing"
        }
      },
      "required": [
        "unit",
        "units_per_credit",
        "payer_organization_id",
        "balance_status",
        "available_units",
        "reserved_units",
        "price_status",
        "prices",
        "sequencing_prices",
        "observed_at",
        "billing_url"
      ],
      "additionalProperties": false
    },
    "PartnerContext": {
      "type": "object",
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/UUID"
        },
        "client_id": {
          "type": "string"
        },
        "actor_kind": {
          "type": "string",
          "enum": [
